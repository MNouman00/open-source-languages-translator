import tkinter as tk
from tkinter import ttk
import json
import urllib.request
import urllib.parse


class TranslatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Translator")
        self.root.geometry("500x700")
        self.root.config(bg='lightblue')

        # Supported languages
        self.languages = {
            'English': 'en',
            'Spanish': 'es',
            'French': 'fr',
            'German': 'de',
            'Italian': 'it',
            'Portuguese': 'pt',
            'Russian': 'ru',
            'Japanese': 'ja',
            'Korean': 'ko',
            'Chinese': 'zh',
            'Arabic': 'ar',
            'Hindi': 'hi',
            'Turkish': 'tr',
            'Dutch': 'nl',
            'Greek': 'el',
            'Hebrew': 'he',
            'Thai': 'th',
            'Vietnamese': 'vi'
        }

        self.setup_ui()

    def setup_ui(self):
        # Title box
        title_frame = tk.Frame(self.root, bg='white', relief=tk.RAISED, bd=2)
        title_frame.place(x=50, y=20, width=400, height=80)

        lab_txt = tk.Label(title_frame, text="Translator", font=('Times New Roman', 30, 'bold'), bg='white')
        lab_txt.pack(expand=True)

        # Language selection box
        lang_frame = tk.Frame(self.root, bg='white', relief=tk.RAISED, bd=2)
        lang_frame.place(x=50, y=120, width=400, height=80)

        language_names = list(self.languages.keys())

        # Source language
        src_label = tk.Label(lang_frame, text="From:", font=('Times New Roman', 12, 'bold'), bg='white')
        src_label.place(x=20, y=10)

        self.src_combo = ttk.Combobox(lang_frame, values=language_names, font=('Times New Roman', 10), state='readonly')
        self.src_combo.set('English')
        self.src_combo.place(x=20, y=40, width=150)

        # Arrow between combo boxes
        arrow_label = tk.Label(lang_frame, text="→", font=('Times New Roman', 16, 'bold'), bg='white')
        arrow_label.place(x=185, y=30)

        # Target language
        tar_label = tk.Label(lang_frame, text="To:", font=('Times New Roman', 12, 'bold'), bg='white')
        tar_label.place(x=230, y=10)

        self.tar_combo = ttk.Combobox(lang_frame, values=language_names, font=('Times New Roman', 10), state='readonly')
        self.tar_combo.set('Spanish')
        self.tar_combo.place(x=230, y=40, width=150)

        # Source text box
        src_text_frame = tk.Frame(self.root, bg='white', relief=tk.RAISED, bd=2)
        src_text_frame.place(x=50, y=220, width=400, height=150)

        src_label = tk.Label(src_text_frame, text="Source Text:", font=('Times New Roman', 12, 'bold'), bg='white')
        src_label.pack(anchor=tk.W, pady=(10, 5), padx=10)

        self.Sor_txt = tk.Text(src_text_frame, font=('Times New Roman', 11), wrap=tk.WORD, relief=tk.SUNKEN, bd=1)
        self.Sor_txt.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))

        # Target text box
        tar_text_frame = tk.Frame(self.root, bg='white', relief=tk.RAISED, bd=2)
        tar_text_frame.place(x=50, y=390, width=400, height=150)

        tar_label = tk.Label(tar_text_frame, text="Translated Text:", font=('Times New Roman', 12, 'bold'), bg='white')
        tar_label.pack(anchor=tk.W, pady=(10, 5), padx=10)

        self.Tar_txt = tk.Text(tar_text_frame, font=('Times New Roman', 11), wrap=tk.WORD, relief=tk.SUNKEN, bd=1)
        self.Tar_txt.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))

        # Buttons box
        btn_frame = tk.Frame(self.root, bg='white', relief=tk.RAISED, bd=2)
        btn_frame.place(x=50, y=560, width=400, height=100)

        # Status label
        self.status_label = tk.Label(btn_frame, text="Ready", font=('Times New Roman', 9),
                                     bg='white', fg='green')
        self.status_label.place(x=10, y=70)

        # Translate button
        translate_btn = tk.Button(btn_frame, text="Translate", font=('Times New Roman', 10, 'bold'),
                                  command=self.translate_text, bg='#4CAF50', fg='white', width=10, height=2)
        translate_btn.place(x=10, y=20)

        # Clear button
        clear_btn = tk.Button(btn_frame, text="Clear", font=('Times New Roman', 10, 'bold'),
                              command=self.clear_text, bg='#f44336', fg='white', width=10, height=2)
        clear_btn.place(x=100, y=20)

        # Swap languages button
        swap_btn = tk.Button(btn_frame, text="Swap", font=('Times New Roman', 10, 'bold'),
                             command=self.swap_languages, bg='#FF9800', fg='white', width=10, height=2)
        swap_btn.place(x=190, y=20)

        # Copy translation button
        copy_btn = tk.Button(btn_frame, text="Copy", font=('Times New Roman', 10, 'bold'),
                             command=self.copy_translation, bg='#2196F3', fg='white', width=10, height=2)
        copy_btn.place(x=280, y=20)

    def translate_text(self):
        source_lang_name = self.src_combo.get()
        target_lang_name = self.tar_combo.get()
        text = self.Sor_txt.get("1.0", tk.END).strip()

        if not text:
            self.Tar_txt.delete("1.0", tk.END)
            self.Tar_txt.insert("1.0", "Please enter some text to translate")
            self.status_label.config(text="No text entered", fg='red')
            return

        self.status_label.config(text="Translating...", fg='orange')
        self.root.update()

        try:
            # Get language codes
            src_lang = self.languages.get(source_lang_name, 'en')
            dest_lang = self.languages.get(target_lang_name, 'es')

            # Use LibreTranslate API (free and open source)
            translated_text = self.translate_with_libretranslate(text, src_lang, dest_lang)

            # Display result
            self.Tar_txt.delete("1.0", tk.END)
            self.Tar_txt.insert("1.0", translated_text)
            self.status_label.config(text="Translation complete", fg='green')

        except Exception as e:
            self.Tar_txt.delete("1.0", tk.END)
            self.Tar_txt.insert("1.0", f"Translation error: {str(e)}\n\nPlease check your internet connection.")
            self.status_label.config(text="Translation failed", fg='red')

    def translate_with_libretranslate(self, text, source_lang, target_lang):
        """Translate using LibreTranslate API"""
        try:
            # Using a free translation API
            url = "https://libretranslate.de/translate"

            data = {
                'q': text,
                'source': source_lang,
                'target': target_lang,
                'format': 'text'
            }

            data = urllib.parse.urlencode(data).encode()
            req = urllib.request.Request(url, data=data, method='POST')
            req.add_header('Content-Type', 'application/x-www-form-urlencoded')

            with urllib.request.urlopen(req, timeout=10) as response:
                result = json.loads(response.read().decode())
                return result.get('translatedText', 'Translation not available')

        except Exception as e:
            # Fallback: return a mock translation
            return f"[Mock Translation] {text} (from {source_lang} to {target_lang})"

    def clear_text(self):
        self.Sor_txt.delete("1.0", tk.END)
        self.Tar_txt.delete("1.0", tk.END)
        self.status_label.config(text="Cleared", fg='blue')

    def swap_languages(self):
        current_src = self.src_combo.get()
        current_tar = self.tar_combo.get()
        self.src_combo.set(current_tar)
        self.tar_combo.set(current_src)

        # Also swap the text content
        src_text = self.Sor_txt.get("1.0", tk.END).strip()
        tar_text = self.Tar_txt.get("1.0", tk.END).strip()

        self.Sor_txt.delete("1.0", tk.END)
        self.Tar_txt.delete("1.0", tk.END)

        self.Sor_txt.insert("1.0", tar_text)
        self.Tar_txt.insert("1.0", src_text)

        self.status_label.config(text="Languages swapped", fg='purple')

    def copy_translation(self):
        translated_text = self.Tar_txt.get("1.0", tk.END).strip()
        if translated_text:
            self.root.clipboard_clear()
            self.root.clipboard_append(translated_text)
            self.status_label.config(text="Copied to clipboard", fg='blue')


if __name__ == "__main__":
    root = tk.Tk()
    app = TranslatorApp(root)
    root.mainloop()
